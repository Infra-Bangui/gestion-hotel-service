# Security / session (client-visible — keep demo passwords off public production)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
NEXT_PUBLIC_SESSION_TIMEOUT_MS=1800000
NEXT_PUBLIC_MAX_LOGIN_ATTEMPTS=5
NEXT_PUBLIC_LOGIN_LOCKOUT_MS=60000

# Optional: override seed account passwords (defaults match the demo accounts)
NEXT_PUBLIC_PASS_POLICE=police123
NEXT_PUBLIC_PASS_HOTEL=hotel123
NEXT_PUBLIC_PASS_ADMIN=admin123
